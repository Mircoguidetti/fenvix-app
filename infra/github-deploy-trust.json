{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GithubActionsProductionEnvironmentOnly",
      "Effect": "Allow",
      "Principal": { "Federated": "arn:aws:iam::865859654353:oidc-provider/token.actions.githubusercontent.com" },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": [
            "repo:Mircoguidetti/fenvix-app:environment:production",
            "repo:Mircoguidetti@17613795/fenvix-app@1434576189:environment:production"
          ]
        }
      }
    }
  ]
}
