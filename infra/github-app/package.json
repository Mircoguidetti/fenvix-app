{
  "name": "fenvix-github-app-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK (TypeScript) for the fenvix GitHub App on Lambda and the self-hosted runner on EC2. docs/DEPLOY-AWS.md",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth --quiet",
    "test": "npm run typecheck && node --test --test-reporter=spec --test-concurrency=1 test/*.test.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "aws-cdk": "^2",
    "aws-cdk-lib": "^2",
    "cdk-nag": "^2",
    "constructs": "^10",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
