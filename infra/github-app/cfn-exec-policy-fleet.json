{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2RunnerNetworkAndInstance",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:DeleteVpc",
        "ec2:ModifyVpcAttribute",
        "ec2:CreateSubnet",
        "ec2:DeleteSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:CreateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:CreateInternetGateway",
        "ec2:DeleteInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:StopInstances",
        "ec2:StartInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyInstanceMetadataOptions",
        "ec2:ModifyInstanceCreditSpecification",
        "ec2:AssociateIamInstanceProfile",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:Describe*",
        "ec2:CreateLaunchTemplate",
        "ec2:CreateLaunchTemplateVersion",
        "ec2:DeleteLaunchTemplate",
        "ec2:ModifyLaunchTemplate",
        "ec2:GetLaunchTemplateData"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "Ec2OnlyTheseSizes",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:eu-west-1:865859654353:instance/*",
      "Condition": {
        "StringNotEquals": {
          "ec2:InstanceType": [
            "t3.medium",
            "t3.large",
            "t3.xlarge",
            "c6i.large",
            "c6i.xlarge",
            "m6i.large",
            "m6i.xlarge",
            "t4g.nano",
            "t4g.micro",
            "t4g.small"
          ]
        }
      }
    },
    {
      "Sid": "ResolveUbuntuAmi",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:eu-west-1::parameter/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id",
        "arn:aws:ssm:eu-west-1::parameter/aws/service/canonical/ubuntu/server/24.04/stable/current/arm64/hvm/ebs-gp3/ami-id"
      ]
    },
    {
      "Sid": "ImageBuilderPipeline",
      "Effect": "Allow",
      "Action": [
        "imagebuilder:CreateComponent",
        "imagebuilder:DeleteComponent",
        "imagebuilder:GetComponent",
        "imagebuilder:CreateImageRecipe",
        "imagebuilder:DeleteImageRecipe",
        "imagebuilder:GetImageRecipe",
        "imagebuilder:CreateInfrastructureConfiguration",
        "imagebuilder:UpdateInfrastructureConfiguration",
        "imagebuilder:DeleteInfrastructureConfiguration",
        "imagebuilder:GetInfrastructureConfiguration",
        "imagebuilder:CreateDistributionConfiguration",
        "imagebuilder:UpdateDistributionConfiguration",
        "imagebuilder:DeleteDistributionConfiguration",
        "imagebuilder:GetDistributionConfiguration",
        "imagebuilder:CreateImagePipeline",
        "imagebuilder:UpdateImagePipeline",
        "imagebuilder:DeleteImagePipeline",
        "imagebuilder:GetImagePipeline",
        "imagebuilder:TagResource",
        "imagebuilder:UntagResource"
      ],
      "Resource": [
        "arn:aws:imagebuilder:eu-west-1:865859654353:component/fenvix-prod-runner/*",
        "arn:aws:imagebuilder:eu-west-1:865859654353:image-recipe/fenvix-prod-runner/*",
        "arn:aws:imagebuilder:eu-west-1:865859654353:infrastructure-configuration/fenvix-prod-runner-build",
        "arn:aws:imagebuilder:eu-west-1:865859654353:distribution-configuration/fenvix-prod-runner",
        "arn:aws:imagebuilder:eu-west-1:865859654353:image-pipeline/fenvix-prod-runner"
      ]
    },
    {
      "Sid": "ImageBuilderParentImage",
      "Effect": "Allow",
      "Action": [
        "imagebuilder:GetImage",
        "ssm:GetParameter"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "ImageBuilderServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::865859654353:role/aws-service-role/imagebuilder.amazonaws.com/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "imagebuilder.amazonaws.com"
        }
      }
    }
  ]
}
