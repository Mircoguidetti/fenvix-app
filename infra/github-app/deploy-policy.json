{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CdkDeployThroughBootstrapRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::865859654353:role/cdk-fenvix-deploy-role-865859654353-eu-west-1",
        "arn:aws:iam::865859654353:role/cdk-fenvix-file-publishing-role-865859654353-eu-west-1"
      ]
    },
    {
      "Sid": "CdkBootstrapVersionCheck",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:eu-west-1:865859654353:parameter/cdk-bootstrap/fenvix/version"
    },
    {
      "Sid": "ReadOwnStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources"
      ],
      "Resource": [
        "arn:aws:cloudformation:eu-west-1:865859654353:stack/fenvix-prod-github-app/*",
        "arn:aws:cloudformation:eu-west-1:865859654353:stack/fenvix-prod-dashboard/*"
      ]
    },
    {
      "Sid": "ClearAFailedFirstCreate",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DeleteStack",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:cloudformation:eu-west-1:865859654353:stack/fenvix-prod-github-app/*",
        "arn:aws:cloudformation:eu-west-1:865859654353:stack/fenvix-prod-dashboard/*",
        "arn:aws:s3:::fenvix-prod-dashboard-865859654353"
      ]
    },
    {
      "Sid": "DiagnoseAFailedDeploy",
      "Effect": "Allow",
      "Action": "cloudtrail:LookupEvents",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "ApiCertificate",
      "Effect": "Allow",
      "Action": [
        "acm:RequestCertificate",
        "acm:DescribeCertificate",
        "acm:ListCertificates",
        "acm:AddTagsToCertificate"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "DashboardCertificateInUsEast1",
      "Effect": "Allow",
      "Action": [
        "acm:RequestCertificate",
        "acm:DescribeCertificate",
        "acm:ListCertificates",
        "acm:AddTagsToCertificate"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ResolveUbuntuAmi",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:eu-west-1::parameter/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id",
        "arn:aws:ssm:eu-west-1::parameter/aws/service/canonical/ubuntu/server/24.04/stable/current/arm64/hvm/ebs-gp3/ami-id"
      ]
    },
    {
      "Sid": "ManageOwnSecrets",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:DescribeParameters"
      ],
      "Resource": [
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/github-app/*",
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/cache/*"
      ]
    },
    {
      "Sid": "ReadWhatThePipelineChecks",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/github-app/database-url",
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/github-app/api-database-url",
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/github-app/private-key",
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/github-app/client-secret",
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/cache/signing-public-key"
      ]
    },
    {
      "Sid": "ReadFounderValues",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/bootstrap/supabase-db-url",
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/bootstrap/supabase-anon-key",
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/bootstrap/supabase-ca-cert",
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/bootstrap/cloudflare-api-token",
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/bootstrap/github-app-id",
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/bootstrap/github-app-slug",
        "arn:aws:ssm:eu-west-1:865859654353:parameter/fenvix/prod/bootstrap/github-app-client-id"
      ]
    },
    {
      "Sid": "ListParameterNames",
      "Effect": "Allow",
      "Action": "ssm:DescribeParameters",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "ReadOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:DescribeLogStreams",
        "logs:StartLiveTail"
      ],
      "Resource": [
        "arn:aws:logs:eu-west-1:865859654353:log-group:/aws/lambda/fenvix-prod-github-app-*",
        "arn:aws:logs:eu-west-1:865859654353:log-group:/aws/apigateway/fenvix-prod-github-app-*"
      ]
    },
    {
      "Sid": "DescribeLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "LookAtQueuesAndMachines",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:GetConsoleOutput",
        "ec2:DescribeImages"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "BuildTheRunnerImage",
      "Effect": "Allow",
      "Action": [
        "imagebuilder:StartImagePipelineExecution",
        "imagebuilder:GetImagePipeline",
        "imagebuilder:ListImagePipelineImages"
      ],
      "Resource": "arn:aws:imagebuilder:eu-west-1:865859654353:image-pipeline/fenvix-prod-runner"
    },
    {
      "Sid": "WatchTheImageBuild",
      "Effect": "Allow",
      "Action": [
        "imagebuilder:GetImage"
      ],
      "Resource": "arn:aws:imagebuilder:eu-west-1:865859654353:image/fenvix-prod-runner/*"
    },
    {
      "Sid": "UploadTheDashboard",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::fenvix-prod-dashboard-865859654353"
    },
    {
      "Sid": "UploadTheDashboardFiles",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::fenvix-prod-dashboard-865859654353/*"
    },
    {
      "Sid": "RefreshTheDashboardCache",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::865859654353:distribution/*"
    },
    {
      "Sid": "RunDemoUpAndDown",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:eu-west-1:865859654353:function:fenvix-prod-github-app-demo"
    }
  ]
}
