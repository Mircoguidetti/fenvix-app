#!/usr/bin/env bash
# GitHub runner job-completed hook (ACTIONS_RUNNER_HOOK_JOB_COMPLETED), as the job user. Puts the job's summary.json
# (written by runner/fenvix-run, default $RUNNER_TEMP/fenvix/summary.json) with the job's ids into the spool; the
# poster sends it. Never fails the job: no summary means the App publishes the run without one.
summary="${FENVIX_SUMMARY_PATH:-${RUNNER_TEMP:-/nonexistent}/fenvix/summary.json}"
if [ ! -f "$summary" ]; then echo "fenvix: no summary.json for this job"; exit 0; fi
python3 -I - "$summary" "${FENVIX_SPOOL:-/var/spool/fenvix-summaries}" <<'PY' || echo "fenvix: could not queue the summary"
import json, os, sys, uuid
path, spool = sys.argv[1], sys.argv[2]
ids = {k: os.environ.get(v, "") for k, v in (("repositoryId", "GITHUB_REPOSITORY_ID"), ("runId", "GITHUB_RUN_ID"), ("runAttempt", "GITHUB_RUN_ATTEMPT"))}
if not all(v.isdigit() for v in ids.values()):
    print(f"fenvix: job ids missing {ids}"); sys.exit(0)
with open(path, encoding="utf-8") as f:
    summary = json.load(f)
env = {k: int(v) for k, v in ids.items()}
env["summary"] = summary
name = f"{env['repositoryId']}-{env['runId']}-{env['runAttempt']}-{uuid.uuid4().hex}.json"
tmp = os.path.join(spool, "." + name + ".tmp")
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(env, f)
os.chmod(tmp, 0o644)
os.rename(tmp, os.path.join(spool, name))
print(f"fenvix: summary queued for run {env['runId']} attempt {env['runAttempt']}")
PY
exit 0
