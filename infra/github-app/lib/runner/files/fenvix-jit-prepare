#!/usr/bin/env bash
# Per-job machine, as root before the runner starts (ExecStartPre=+): the just-in-time configuration for the runner
# user; the shared-cache token of this job (minted by the worker for this customer's cache organization only; write
# for a trusted ref, read for anything else), as the hand-off file that fenvix-run reads once and deletes; the cache
# settings in the runner's job environment. Both come from the user data (root only); no AWS call.
# Root reads the root-only files; every write into the job user's home is done AS the job user (a path there may be a
# symlink planted in the image), so root never follows one.
set -euo pipefail
# shellcheck source=/dev/null
. /etc/fenvix/runner.env
home=/home/fenvix
umask 077
as_fenvix() { runuser -u fenvix -- "$@"; }
# shellcheck disable=SC2016
put() { as_fenvix sh -c 'umask 077; cat >"$1"' _ "$1"; }      # stdin -> a file of the job user
# shellcheck disable=SC2016
add() { as_fenvix sh -c 'cat >>"$1"' _ "$1"; }                # stdin appended to a file of the job user
as_fenvix mkdir -p -m 0700 "$home/.fenvix"
put "$home/.fenvix/jitconfig" </etc/fenvix/jitconfig
shred -u /etc/fenvix/jitconfig 2>/dev/null || rm -f /etc/fenvix/jitconfig

env_file="$home/fenvix/actions-runner/.env"
if [ -n "${FENVIX_CACHE_URL:-}" ]; then
  token=""
  if [ -f /etc/fenvix/cache-token ]; then
    token="$(cat /etc/fenvix/cache-token)"
    shred -u /etc/fenvix/cache-token 2>/dev/null || rm -f /etc/fenvix/cache-token
  fi
  {
    printf 'FENVIX_CACHE_URL=%s\n' "$FENVIX_CACHE_URL"
    printf 'FENVIX_CACHE_ALLOW_HTTP=1\n'   # inside the VPC only: the cache machine has no public address
  } | add "$env_file"
  if [ -n "$token" ]; then
    printf '%s' "$token" | put "$home/.fenvix/cache-token"
    printf 'FENVIX_CACHE_TOKEN_FILE=%s\n' "$home/.fenvix/cache-token" | add "$env_file"
  else
    echo "[fenvix-jit-prepare] no shared-cache token: the cache service refuses; the job uses the local cache"
  fi
  unset token
fi
