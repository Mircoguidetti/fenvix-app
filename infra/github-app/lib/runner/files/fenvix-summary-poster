#!/usr/bin/env python3
"""Sends what the job-completed hook spooled to the fenvix GitHub App: per-test result chunks (POST /v1/runner/results,
the summaries URL with its last segment `results`) and run summaries (POST /v1/runner/summaries).

Runs as `fenvix-post`, the only user that can read this machine's summary credential (minted for this machine only:
the App takes the runner name, the repository and, per job, the run from the credential). The runner name in the body
is this machine's (not the job's word for it). 2xx: done. 4xx other than 408/429: kept in rejected/ for a look. Anything else: tried again later.

Spool names (spec C1): `<repositoryId>-<runId>-<runAttempt>-0-<chunk:04d>-<uuid>.json` for a results chunk,
`<repositoryId>-<runId>-<runAttempt>-1-<uuid>.json` for the summary (an older hook's `<…>-<uuid>.json` is a summary too).
A job's chunks sort before its summary and are sent first; the summary is held back while a chunk of the same job is
still in the spool, but at most HOLD_SECONDS after it was spooled: then it is sent anyway (the machine powers off within
2 minutes, fenvix-job-done, and the App publishes without a summary after SUMMARY_WAIT_SECONDS).

Environment: FENVIX_SUMMARIES_URL, FENVIX_RUNNER_NAME, FENVIX_TOKEN_FILE, FENVIX_SPOOL, FENVIX_POSTER_ONCE=1 (one pass).
"""
import json, os, sys, time, urllib.error, urllib.parse, urllib.request

URL = os.environ["FENVIX_SUMMARIES_URL"]
RESULTS_URL = urllib.parse.urljoin(URL, "results")  # .../v1/runner/summaries -> .../v1/runner/results
RUNNER = os.environ["FENVIX_RUNNER_NAME"]
TOKEN_FILE = os.environ.get("FENVIX_TOKEN_FILE", "/run/fenvix-post/summary-token")
SPOOL = os.environ.get("FENVIX_SPOOL", "/var/spool/fenvix-summaries")
ONCE = os.environ.get("FENVIX_POSTER_ONCE") == "1"
MAX_AGE = 2 * 86400  # the App publishes without a summary after SUMMARY_WAIT_SECONDS anyway
HOLD_SECONDS = 60  # a summary waits at most this long for its job's results chunks


def log(msg):
    print(f"[fenvix-summary-poster] {msg}", flush=True)


def token():
    with open(TOKEN_FILE, encoding="utf-8") as f:
        return f.read().strip()


def send(path):
    with open(path, encoding="utf-8") as f:
        env = json.load(f)
    ids = {k: env[k] for k in ("repositoryId", "runId", "runAttempt")}
    if not all(isinstance(v, int) and v > 0 for v in ids.values()):
        return 400, "malformed spool file"
    if isinstance(env.get("results"), dict):
        # the chunk's own fields, then the job's ids and this machine's name (a chunk never names them itself)
        url, body = RESULTS_URL, {**env["results"], **ids, "runnerName": RUNNER}
    elif isinstance(env.get("summary"), dict):
        url, body = URL, {**ids, "runnerName": RUNNER, "summary": env["summary"]}
    else:
        return 400, "malformed spool file"
    req = urllib.request.Request(url, data=json.dumps(body).encode(), method="POST",
                                 headers={"content-type": "application/json", "authorization": f"Bearer {token()}",
                                          "user-agent": "fenvix-summary-poster"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.status, ""
    except urllib.error.HTTPError as e:
        return e.code, e.read(500).decode("utf-8", "replace")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        return 0, str(e)


def job_of(name):
    """(job key, kind) of a spool name: kind "0" a results chunk, "1" a summary (an older hook's name: a summary)."""
    parts = name.split("-")
    if len(parts) >= 5 and parts[3] in ("0", "1"):
        return "-".join(parts[:3]), parts[3]
    return "-".join(parts[:3]), "1"


def results_pending(key):
    """A results chunk of this job still in the spool (not in rejected/, not half-written)."""
    return any(not n.startswith(".") and job_of(n) == (key, "0") and os.path.isfile(os.path.join(SPOOL, n))
               for n in os.listdir(SPOOL))


def one_pass():
    now = time.time()
    for name in sorted(os.listdir(SPOOL)):
        path = os.path.join(SPOOL, name)
        if not os.path.isfile(path):
            continue
        age = now - os.path.getmtime(path)
        if name.startswith("."):
            if age > 3600:
                os.remove(path)  # a hook that died half way
            continue
        if age > MAX_AGE:
            log(f"{name}: older than {MAX_AGE}s, dropped")
            os.remove(path)
            continue
        key, kind = job_of(name)
        if kind == "1" and age < HOLD_SECONDS and results_pending(key):
            log(f"{name}: held: results of this job not sent yet ({int(age)}s of {HOLD_SECONDS}s)")
            continue
        try:
            status, detail = send(path)
        except (ValueError, KeyError) as e:
            status, detail = 400, f"unreadable: {e}"
        if 200 <= status < 300:
            os.remove(path)
            log(f"{name}: sent ({status})")
        elif 400 <= status < 500 and status not in (408, 429):
            os.makedirs(os.path.join(SPOOL, "rejected"), exist_ok=True)
            os.replace(path, os.path.join(SPOOL, "rejected", name))
            log(f"{name}: refused ({status}) {detail[:200]}; kept in rejected/")
        else:
            log(f"{name}: not sent ({status or 'network'}) {detail[:200]}; will retry")


def main():
    while True:
        try:
            one_pass()
        except OSError as e:
            log(f"pass failed: {e}")
        if ONCE:
            return 0
        time.sleep(5)


if __name__ == "__main__":
    sys.exit(main())
