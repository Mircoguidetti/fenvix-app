#!/usr/bin/env bash
# Per-job machine, as root after the runner exits (ExecStopPost=+): give the poster up to 2 minutes to send the
# summary, then power off. The launch template's shutdown behaviour is "terminate": AWS deletes the machine and disk.
spool=/var/spool/fenvix-summaries
for _ in $(seq 1 24); do
  if [ -z "$(find "$spool" -maxdepth 1 -type f ! -name '.*' 2>/dev/null)" ]; then break; fi
  sleep 5
done
echo "[fenvix-job-done] job finished; powering off"
systemctl poweroff --no-block
