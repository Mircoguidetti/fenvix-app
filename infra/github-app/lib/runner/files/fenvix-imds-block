#!/usr/bin/env bash
# The machine's AWS role can read RUNNER_TOKEN and the registration token. Job code runs as `fenvix`: it must not
# reach the instance metadata service (where the role's credentials are), and neither does the poster.
set -euo pipefail
for u in fenvix fenvix-post; do
  id "$u" >/dev/null 2>&1 || continue
  iptables -C OUTPUT -d 169.254.169.254 -m owner --uid-owner "$u" -j REJECT 2>/dev/null \
    || iptables -I OUTPUT -d 169.254.169.254 -m owner --uid-owner "$u" -j REJECT
  ip6tables -C OUTPUT -d fd00:ec2::254 -m owner --uid-owner "$u" -j REJECT 2>/dev/null \
    || ip6tables -I OUTPUT -d fd00:ec2::254 -m owner --uid-owner "$u" -j REJECT || true
done
