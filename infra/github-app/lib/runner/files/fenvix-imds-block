#!/usr/bin/env bash
# The instance metadata service is for root only (audit G-0003 class, N3). Every other uid on the machine (the job
# slots fenvix-s1..s16, the GitHub runner, any process a job starts, the poster) is refused 169.254.169.254 and
# fd00:ec2::254, whatever its uid: the rule matches "not root", not a list of users, so a new user is covered too.
# IMDSv2 with hop limit 1 (launch template) also keeps containers in their own network namespace out.
set -euo pipefail
rule4=(OUTPUT -d 169.254.169.254 -m owner ! --uid-owner 0 -j REJECT)
rule6=(OUTPUT -d fd00:ec2::254 -m owner ! --uid-owner 0 -j REJECT)
iptables -C "${rule4[@]}" 2>/dev/null || iptables -I "${rule4[@]}"
ip6tables -C "${rule6[@]}" 2>/dev/null || ip6tables -I "${rule6[@]}" || true
