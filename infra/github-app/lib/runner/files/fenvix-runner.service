[Unit]
Description=fenvix GitHub Actions runner (labels self-hosted, fenvix)
Wants=network-online.target
After=network-online.target fenvix-imds-block.service
Requires=fenvix-imds-block.service

[Service]
User=fenvix
Group=fenvix
EnvironmentFile=/etc/fenvix/runner.env
Environment=HOME=/home/fenvix FENVIX_HOME=/home/fenvix/fenvix
# Registers once (waits for the token in SSM; as root, then drops to fenvix), then serves jobs.
ExecStartPre=+/opt/fenvix/bin/fenvix-register
ExecStart=/home/fenvix/engine-cli/runner/bootstrap.sh run
Restart=always
RestartSec=15
TimeoutStartSec=infinity
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
