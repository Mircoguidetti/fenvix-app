#!/usr/bin/env bash
# Demo machine, as root before the runner starts (ExecStartPre=+). Already registered: nothing to do. Otherwise reads
# the one-hour registration token the user data wrote (/etc/fenvix/registration-token, root only), registers as
# `fenvix`, then shreds the token. No AWS call.
set -uo pipefail
# shellcheck source=/dev/null
. /etc/fenvix/runner.env
RUNNER_DIR=/home/fenvix/fenvix/actions-runner
TOKEN_FILE=/home/fenvix/.fenvix/registration-token
log() { printf '[fenvix-register] %s\n' "$*"; }

[ -f "$RUNNER_DIR/.runner" ] && { log "already registered as $FENVIX_RUNNER_NAME"; exit 0; }
fetch_token() {
  [ -f /etc/fenvix/registration-token ] || return 1
  cat /etc/fenvix/registration-token
  shred -u /etc/fenvix/registration-token 2>/dev/null || rm -f /etc/fenvix/registration-token
}
while :; do
  if token="$(fetch_token)" && [ -n "$token" ]; then
    # Written as `fenvix` (a path in its home may be a symlink): root never writes there.
    # shellcheck disable=SC2016
    printf '%s' "$token" | runuser -u fenvix -- sh -c 'umask 077; mkdir -p "$(dirname "$1")"; cat >"$1"' _ "$TOKEN_FILE"
    unset token
    runuser -u fenvix -- env HOME=/home/fenvix FENVIX_HOME=/home/fenvix/fenvix FENVIX_REPO_URL="$FENVIX_REPO_URL" \
      FENVIX_RUNNER_NAME="$FENVIX_RUNNER_NAME" bash /home/fenvix/engine-cli/runner/bootstrap.sh register
    rc=$?
    # shellcheck disable=SC2016 # expanded by the inner sh, on purpose
    runuser -u fenvix -- sh -c 'shred -u "$1" 2>/dev/null || rm -f "$1"' _ "$TOKEN_FILE"
    if [ $rc -eq 0 ]; then log "registered as $FENVIX_RUNNER_NAME on $FENVIX_REPO_URL; token deleted"; exit 0; fi
    log "registration failed (exit $rc; an expired token?). demo: run scripts/demo-down.sh and demo-up.sh again."
  else
    log "no registration token in /etc/fenvix/registration-token: run scripts/demo-down.sh and demo-up.sh again"
  fi
  sleep 30
done
