#!/usr/bin/env bash
# Runs as root before the poster starts (ExecStartPre=+): this machine's summary credential, written by the user data
# to /etc/fenvix/summary-token (root only), moves into the poster's private directory. The credential is minted per
# machine by the worker (per-job: bound to one runner name, repository and run) or the demo function (one runner name
# and the demo repository); the App takes the runner's identity from it, never from the request body (R-012 F1).
# No AWS call: the machine's role may do nothing.
set -euo pipefail
umask 077
src=/etc/fenvix/summary-token
dir=/run/fenvix-post
install -d -m 0700 -o fenvix-post -g fenvix-post "$dir"
if [ -f "$src" ]; then
  install -m 0400 -o fenvix-post -g fenvix-post "$src" "$dir/summary-token.new"
  mv -f "$dir/summary-token.new" "$dir/summary-token"
  shred -u "$src" 2>/dev/null || rm -f "$src"
elif [ ! -f "$dir/summary-token" ]; then
  echo "[fenvix-summary-credential] no summary credential: summaries are not sent" >&2
  exit 1
fi
