#!/usr/bin/env bash
# Per-job machine (timer, as root): if no job started within FENVIX_IDLE_MINUTES of boot (the job was cancelled, or
# another machine took it), power off; the machine terminates. The reaper Lambda is the second line.
# shellcheck source=/dev/null
. /etc/fenvix/runner.env
limit=$(( ${FENVIX_IDLE_MINUTES:-20} * 60 ))
up=$(cut -d. -f1 /proc/uptime)
if [ "$up" -ge "$limit" ] && [ ! -e /home/fenvix/.fenvix/job-started ]; then
  echo "[fenvix-idle-watchdog] no job after ${up}s; powering off"
  systemctl poweroff --no-block
fi
