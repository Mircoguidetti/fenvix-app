[Unit]
Description=fenvix just-in-time GitHub runner (one job, then the machine powers off)
Wants=network-online.target
After=network-online.target fenvix-imds-block.service fenvix-summary-poster.service
Requires=fenvix-imds-block.service

[Service]
Type=simple
User=fenvix
Group=fenvix
EnvironmentFile=/etc/fenvix/runner.env
Environment=HOME=/home/fenvix FENVIX_HOME=/home/fenvix/fenvix
ExecStartPre=+/opt/fenvix/bin/fenvix-jit-prepare
# bootstrap.sh finds ~/.fenvix/jitconfig and runs: run.sh --jitconfig (exactly one job, no registration step).
ExecStart=/home/fenvix/engine-cli/runner/bootstrap.sh run
ExecStopPost=+/opt/fenvix/bin/fenvix-job-done
Restart=no
TimeoutStopSec=5min
KillMode=process
