# Public settings for the browser: every value here is safe to publish. Never put the service_role key, the database
# password or an OAuth client secret in here.

# The fenvix API, including /v1 (a bare host gets /v1 added). The dashboard reads and changes all its data through it.
VITE_API_URL=https://api.fenvix.dev/v1

# Supabase, for sign-in only (Supabase Auth). The API receives the session's access token.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "mock" for local development and the Playwright checks (sample data, fake sign-in). Leave empty for the API.
VITE_DATA_BACKEND=
