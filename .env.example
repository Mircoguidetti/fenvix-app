# Public settings for the browser. Both values are safe to publish: every table is behind
# row level security. Never put the service_role key or the database password in here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "supabase" (default) or "mock". The Playwright checks run with mock.
VITE_DATA_BACKEND=
