# Public settings for the browser. Both values are safe to publish: every table is behind
# row level security. Never put the service_role key or the database password in here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "supabase" (default) or "mock". The Playwright checks run with mock.
VITE_DATA_BACKEND=

# The control-plane API including /v1, for the Data tab of a database (the Data Explorer), for example
# https://api.fenvix.cloud/v1. Public. Leave empty and the Data tab says it is not set up yet.
VITE_API_URL=
