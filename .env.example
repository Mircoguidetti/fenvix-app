# Public settings for the browser. Both values are safe to publish: every table is behind
# row level security. Never put the service_role key or the database password in here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "supabase" (default) or "mock". The Playwright checks run with mock.
VITE_DATA_BACKEND=

# Host every database answers on, shown in connection strings when the dashboard talks to Supabase directly
# (no VITE_API_URL). Defaults to db.fenvix.dev; set it only to point a non-production dashboard at another domain.
VITE_DB_HOST=

# The control-plane API including /v1, for example https://api.fenvix.dev/v1 (a bare host gets /v1 added). Public.
# When set, every data screen (databases, usage, billing, keys, settings, Data, Users, Network) goes through the
# control plane, and Supabase is only used for sign-in. Leave empty and the dashboard uses the Supabase functions;
# the Data, Users and Network tabs then say they are not set up.
VITE_API_URL=
