{
  "name": "fenvix-app",
  "private": true,
  "description": "FENVIX customer dashboard",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run api:check && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "npm run api:check && tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "ui-shots": "node scripts/ui-shots.mjs",
    "checks": "node scripts/checks.mjs",
    "check": "node scripts/run.mjs",
    "test:unit": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/unit/*.test.ts",
    "test:rls": "bash supabase/tests/run-local.sh",
    "test:e2e": "node scripts/supabase-e2e.mjs",
    "api:generate": "openapi-typescript openapi/fenvix-api.yaml -o src/api/schema.d.ts",
    "api:lint": "redocly lint openapi/fenvix-api.yaml",
    "api:check": "node scripts/api-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@redocly/cli": "^2.80.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
