{
  "name": "fenvix-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "FENVIX control-plane API: the service between the dashboard and the engine",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --test-reporter=spec tests/unit/*.test.ts",
    "test:integration": "node --test --test-reporter=spec --test-concurrency=1 tests/integration/*.test.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration",
    "db:prepare": "bash scripts/prepare-test-db.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.0"
  }
}
