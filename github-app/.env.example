# Copy to .env for a local run. Secrets are NEVER committed: the values below are placeholders.
# See ../docs/GITHUB-APP.md for where each value comes from.
GITHUB_APP_DATABASE_URL=postgresql://fenvix_github_app:<password>@localhost:5432/postgres
GITHUB_APP_ID=<numeric App ID>
GITHUB_APP_SLUG=fenvix
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/fenvix-github-app.pem
GITHUB_WEBHOOK_SECRET=<openssl rand -hex 32>
GITHUB_CLIENT_ID=<Client ID>
GITHUB_CLIENT_SECRET=<client secret>
DASHBOARD_URL=https://console.fenvix.dev
SUPABASE_URL=https://<ref>.supabase.co
STATE_SIGNING_KEY=<openssl rand -hex 32>
RUNNER_TOKEN=<openssl rand -hex 32>
# FENVIX_RUNS_ON=fenvix
# ONBOARDING_BRANCH=fenvix/runs-on
# ONBOARD_ALL_REPOSITORIES=false
# RUNNER_TOKEN_PREVIOUS=<the previous runner token, only while rotating it>
# GITHUB_API_URL=https://api.github.com
# GITHUB_OAUTH_URL=https://github.com
# GITHUB_WEB_URL=https://github.com
# GITHUB_TIMEOUT_MS=15000
# HOST=0.0.0.0
# PORT=8790
# LOG_LEVEL=info
# DB_POOL_MAX=10
# SUMMARY_WAIT_SECONDS=600
# SWEEP_SECONDS=60

# ---- the dashboard API (src/api/, src/lambda/api.ts)
# API_DATABASE_URL=postgresql://fenvix_api:<password>@localhost:6543/postgres
# API_CORS_ORIGINS=https://preview.fenvix.dev
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# FENVIX_MACHINE_REGIONS=eu                 # the regions with machines; an organization may choose only these

# ---- our machines (src/machines/; RUNNER_MODE=pool is set by the stack on the worker, sweep, warm-up and HTTP)
# RUNNER_MODE=pool
# RUNNER_PLACEMENT={"eu":{"awsRegion":"eu-west-1","launchTemplateId":"lt-0123456789abcdef0"}}
# RUNNER_LAUNCH_TEMPLATE_ID=lt-0123456789abcdef0
# FENVIX_POOL={"sizes":{"standard":{"instanceType":"c7a.xlarge","slots":2}},"defaultSize":"standard","alwaysOn":1,"reserve":2}
# FENVIX_API_URL=https://api.fenvix.dev    # what the machines call
# FENVIX_ENV=prod
# FENVIX_MACHINE_FENVIX_CACHE_URL=http://10.42.0.10:8787          # plain machine settings: FENVIX_MACHINE_<NAME>
# FENVIX_MACHINE_FENVIX_SUMMARIES_URL=https://api.fenvix.dev/v1/runner/summaries
# CACHE_SIGNING_KEY_FILE=/run/secrets/fenvix-cache-signing-key.pem  # signs one shared-cache token per job
# REAP=runner-pool:7                        # the reaper Lambda: role:hours

# ---- warm-ups (src/warmup/; off until the engine ships its warm-up executor)
# WARMUP_ENABLED=false
# WARMUP_DAILY_CAP=6
# WARMUP_ORG_CONCURRENCY=1
# WARMUP_RESERVE=1
# WARMUP_GRACE_SECONDS=180
# WARMUP_TICK_SECONDS=0
# WARMUP_MAX_ATTEMPTS=3
# WARMUP_MAX_SECONDS=3600
# WARMUP_START_TIMEOUT_SECONDS=900
# WARMUP_PREEMPT_BACKOFF_SECONDS=600
# WARMUP_WAITING_JOB_WINDOW_SECONDS=900

# ---- AWS Lambda only (set by the stack)
# SSM_PREFIX=/fenvix/prod/github-app
# WORK_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/<account>/fenvix-prod-github-app-work
# OVERFLOW_BUCKET=<bucket>
# CACHE_SIGNING_KEY_PARAM=/fenvix/prod/cache/signing-key
# SECRETS_TTL_SECONDS=300
