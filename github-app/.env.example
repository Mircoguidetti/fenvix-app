# Copy to .env for a local run. Secrets are NEVER committed: the values below are placeholders.
# See ../docs/GITHUB-APP.md for where each value comes from.
GITHUB_APP_DATABASE_URL=postgresql://fenvix_github_app:<password>@localhost:5432/postgres
GITHUB_APP_ID=<numeric App ID>
GITHUB_APP_SLUG=fenvix
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/fenvix-github-app.pem
GITHUB_WEBHOOK_SECRET=<openssl rand -hex 32>
GITHUB_CLIENT_ID=<Client ID>
GITHUB_CLIENT_SECRET=<client secret>
DASHBOARD_URL=https://console.fenvix.dev
SUPABASE_URL=https://<ref>.supabase.co
STATE_SIGNING_KEY=<openssl rand -hex 32>
RUNNER_TOKEN=<openssl rand -hex 32>
# FENVIX_RUNS_ON=fenvix
# ONBOARDING_BRANCH=fenvix/runs-on
# ONBOARD_ALL_REPOSITORIES=false
